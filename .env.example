# Copy to .env.local for local development. Never commit real values.
# Only PUBLIC values belong in VITE_* variables: Vite inlines them into the browser bundle.

# Optional. HTTPS endpoint that accepts the contact form as JSON (a hosted form service).
# Leave blank to keep the contact form in its disabled demo state.
VITE_CONTACT_FORM_ENDPOINT=

# Supabase (public values only). Set both to switch the site from demo mode to backend mode.
# The publishable key is public by design. A secret/service-role key, database password,
# payment secret or webhook secret must NEVER be prefixed VITE_ or imported by frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required for production bot verification. Public site key only; server secret belongs in Supabase.
VITE_TURNSTILE_SITE_KEY=
# Production builds without Supabase must explicitly select demo. Leave blank for backend deployments.
VITE_STORE_MODE=

# SSR server canonical origin. Set to the actual deployment origin; ownership of a domain is insufficient.
SITE_URL=
# Required staging isolation controls (server/build only, never exposed to the browser).
# Vercel Preview deployments require staging tier and separate staging backend credentials.
OLDVERGE_DEPLOYMENT_TIER=
STAGING_SUPABASE_URL=
PRODUCTION_SUPABASE_URL=
# Explicitly set to none only while no production backend exists. Otherwise set PRODUCTION_SUPABASE_URL.
OLDVERGE_PRODUCTION_BACKEND=
