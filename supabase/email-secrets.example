# Server-only Edge Function secrets. Copy to a private, ignored location outside source control.
# This is separate from Supabase Auth SMTP. Never use VITE_* names for these.
# Provider must be mailtrap_sandbox; other values disable the adapter.
COMMERCE_EMAIL_PROVIDER=
# The implementation accepts only the existing staging site/project/sandbox.
COMMERCE_EMAIL_SITE_URL=
MAILTRAP_SANDBOX_ID=
# API token for the existing Mailtrap sandbox, NOT its SMTP password or GitHub password.
MAILTRAP_SANDBOX_API_TOKEN=
# Comma-separated exact test inbox addresses; no wildcards. Admin address must be included.
COMMERCE_EMAIL_ALLOWED_RECIPIENTS=
COMMERCE_EMAIL_ADMIN_TO=
